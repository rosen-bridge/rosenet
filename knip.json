{
  "$schema": "https://unpkg.com/knip/schema.json",
  "workspaces": {
    "packages/**": {
      "entry": ["lib/{index,cli,main}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}"]
    }
  },
  "ignoreDependencies": [
    "js-yaml",
    "@typescript-eslint/eslint-plugin",
    "eslint-config-prettier",
    "@typescript-eslint/parser"
  ],
  "ignoreBinaries": ["vitest"]
}
