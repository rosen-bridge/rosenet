{
  "name": "@rosen-bridge/rosenet-utils",
  "version": "0.4.1",
  "description": "Utils used inside RoseNet",
  "repository": "https://github.com/rosen-bridge/rosenet",
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "prettify": "prettier --write . --ignore-path ./.gitignore",
    "release": "npm run test -- --run && npm run build && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@libp2p/crypto": "^4.0.2",
    "@libp2p/interface": "^1.7.0",
    "@libp2p/peer-id-factory": "^4.2.4",
    "@rosen-bridge/abstract-logger": "^4.0.0",
    "json-diff": "^1.0.6",
    "libp2p": "^1.9.2",
    "multiformats": "^13.1.0",
    "uint8arrays": "^5.1.0"
  },
  "devDependencies": {
    "@multiformats/multiaddr": "^12.2.1",
    "@types/json-diff": "^1.0.3",
    "@types/node": "^20.11.9",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitest/coverage-istanbul": "^3.1.4",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "interface-datastore": "^8.2.11",
    "prettier": "^3.2.4",
    "tsx": "^4.19.3",
    "typescript": "^5.3.3",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
