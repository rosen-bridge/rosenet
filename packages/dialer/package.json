    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@rosen-bridge/abstract-logger": "^2.0.1",
    "@rosen-bridge/json-bigint": "^0.1.0",
    "@rosen-bridge/rosenet-node": "^0.3.0",
    "lodash-es": "^4.17.21"
  }
